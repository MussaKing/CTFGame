@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<section class="card narrow">
    <h1>Регистрация</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="field-error"></div>
        <label asp-for="Input.UserName">Имя пользователя</label>
        <input asp-for="Input.UserName" autocomplete="username" />
        <span asp-validation-for="Input.UserName" class="field-error"></span>

        <label asp-for="Input.Password">Пароль</label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>

        <label asp-for="Input.ConfirmPassword">Повторите пароль</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>

        <button type="submit" class="btn">Создать аккаунт</button>
    </form>
    <p class="muted">Уже есть аккаунт? <a asp-page="Login">Войдите</a></p>
</section>
