<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — CTF Game</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-page="/Index">CTF<span>::</span>Game</a>
    <nav>
        <a asp-page="/Challenges/Index">Задания</a>
        <a asp-page="/Scoreboard">Рейтинг</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="/Admin/Index">Админка</a>
        }
    </nav>
    <div class="user">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="muted">@User.Identity.Name</span>
            <form method="post" asp-page="/Account/Logout" class="inline">
                <button type="submit" class="link">Выйти</button>
            </form>
        }
        else
        {
            <a asp-page="/Account/Login">Вход</a>
            <a asp-page="/Account/Register" class="btn small">Регистрация</a>
        }
    </div>
</header>

<main class="container">
    @if (TempData["Success"] is string success)
    {
        <div class="alert success">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert error">@error</div>
    }
    @RenderBody()
</main>

<footer class="container muted">CTF Game · ASP.NET Core</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
