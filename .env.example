# Скопируйте в .env и поменяйте значения. Файл .env в git не попадает.

# Пароль пользователя ctf в PostgreSQL. Это значение совпадает с appsettings.Development.json,
# чтобы `dotnet run` работал с базой из Docker. На реальном сервере поменяйте его.
POSTGRES_PASSWORD=ctf_dev_password

# Администратор сайта. Пароль применяется только при создании админа (в пустой базе).
# Если оставить пустым, пароль сгенерируется и появится в логах: docker compose logs app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Порт сайта на хосте: http://localhost:5080
APP_PORT=5080

# Часовой пояс для отображения времени решений
TZ=Europe/Moscow
